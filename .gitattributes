# Keep checkout bytes in LF. Windows core.autocrlf otherwise rewrites
# Unity .meta and sources, and scripts/test_pack_unity.py compares those
# bytes to LF fixtures.
* text=auto eol=lf

*.meta text eol=lf
*.cs text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.iss text eol=lf
*.toml text eol=lf
*.rs text eol=lf

*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
